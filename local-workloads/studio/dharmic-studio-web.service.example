[Unit]
Description=Dharmic Swipe Studio web

[Service]
Type=simple
WorkingDirectory=/home/chaiwithjai/Documents/code/dharmic-data/local-workloads/studio-web
ExecStart=/home/chaiwithjai/.local/share/node/bin/node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 8780 --strictPort
Environment=MLFLOW_TRACKING_URI=http://127.0.0.1:5001
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
